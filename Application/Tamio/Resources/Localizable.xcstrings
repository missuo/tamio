          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会导入 OpenSSH known_hosts。Tamio 保留独立的主机密钥验证，并在首次连接时记录密钥；不会复制不安全的 OpenSSH 信任设置。"
          }
        }
      }
    },
