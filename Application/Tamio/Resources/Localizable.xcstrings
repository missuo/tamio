    },
    "Your servers and identities stay on this device. A device that still syncs will store its own again, so turn sync off there too.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your servers and identities stay on this device. A device that still syncs will store its own again, so turn sync off there too."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的服务器和身份凭据会保留在此设备上。仍在同步的设备会重新存储它自己的数据，因此也请在那里关闭同步。"
          }
        }
      }
    },
