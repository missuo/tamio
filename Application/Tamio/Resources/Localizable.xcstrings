{
  "sourceLanguage": "en",
  "strings": {
    "A Host alias at %@:%lld cannot safely be imported.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Host alias at %@:%lld cannot safely be imported."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法安全导入 %1$@:%2$lld 处的 Host 别名。"
          }
        }
      }
    },
    "A matching server was added during review. Review the import again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A matching server was added during review. Review the import again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查期间新增了匹配的服务器。请重新检查导入内容。"
          }
        }
      }
    },
    "A saved server changed during review. Review the import again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A saved server changed during review. Review the import again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查期间已有服务器发生变化。请重新检查导入内容。"
          }
        }
      }
    },
    "A saved server matches this alias but was not imported from this source. Updating it requires explicit permission.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A saved server matches this alias but was not imported from this source. Updating it requires explicit permission."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有服务器与此别名匹配，但并非从此来源导入。更新前需要明确授权。"
          }
        }
      }
    },
    "An Include at %@:%lld uses expansion that cannot be inspected safely.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An Include at %@:%lld uses expansion that cannot be inspected safely."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@:%2$lld 处的 Include 使用了无法安全检查的展开规则。"
          }
        }
      }
    },
    "An SSH Include pattern matches too many files.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An SSH Include pattern matches too many files."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH Include 模式匹配了过多文件。"
          }
        }
      }
    },
    "An identity path contains expansion tokens Tamio cannot resolve. Choose its private key explicitly.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An identity path contains expansion tokens Tamio cannot resolve. Choose its private key explicitly."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "某个身份文件路径含有 Tamio 无法解析的展开标记。请明确选择对应私钥。"
          }
        }
      }
    },
    "Cannot safely inspect SSH configuration syntax at %@:%lld.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot safely inspect SSH configuration syntax at %@:%lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法安全检查 %1$@:%2$lld 处的 SSH 配置语法。"
          }
        }
      }
    },
    "Could not create the private SSH configuration snapshot.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not create the private SSH configuration snapshot."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法创建私有 SSH 配置快照。"
          }
        }
      }
    },
    "Could not inspect Include directory %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not inspect Include directory %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法检查 Include 目录 %@。"
          }
        }
      }
    },
    "Could not inspect SSH Include path %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not inspect SSH Include path %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法检查 SSH Include 路径 %@。"
          }
        }
      }
    },
    "Could not read SSH configuration file %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read SSH configuration file %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取 SSH 配置文件 %@。"
          }
        }
      }
    },
    "Could not read the OpenSSH configuration result.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read the OpenSSH configuration result."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取 OpenSSH 配置解析结果。"
          }
        }
      }
    },
    "Could not start the system OpenSSH configuration resolver.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not start the system OpenSSH configuration resolver."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法启动系统 OpenSSH 配置解析器。"
          }
        }
      }
    },
    "Importing OpenSSH private keys is available on macOS.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Importing OpenSSH private keys is available on macOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSSH 私钥导入仅适用于 macOS。"
          }
        }
      }
    },
    "Match conditions can depend on this Mac, its network, and the time of import. Review the resolved settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Match conditions can depend on this Mac, its network, and the time of import. Review the resolved settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Match 条件可能依赖于当前 Mac、网络和导入时间。请检查解析后的设置。"
          }
        }
      }
    },
    "Match exec can run local commands while OpenSSH resolves this configuration. Resolve only if you trust every included file.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Match exec can run local commands while OpenSSH resolves this configuration. Resolve only if you trust every included file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSSH 解析此配置时，Match exec 可执行本地命令。仅在信任所有包含文件时继续解析。"
          }
        }
      }
    },
    "Match rules are resolved only for this import. Tamio does not reevaluate them when connecting.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Match rules are resolved only for this import. Tamio does not reevaluate them when connecting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Match 规则仅在此次导入时解析。Tamio 不会在连接时重新求值。"
          }
        }
      }
    },
    "No credential is selected. You may explicitly save this server as a draft and choose credentials before connecting.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No credential is selected. You may explicitly save this server as a draft and choose credentials before connecting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未选择凭据。可以明确将此服务器保存为待配置项，并在连接前选择凭据。"
          }
        }
      }
    },
    "OpenSSH could not resolve this host. Check the configuration for invalid or unsupported settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSSH could not resolve this host. Check the configuration for invalid or unsupported settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSSH 无法解析此主机。请检查配置中无效或不支持的设置。"
          }
        }
      }
    },
    "OpenSSH did not resolve a valid host, port and user.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSSH did not resolve a valid host, port and user."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSSH 未解析出有效的主机、端口和用户。"
          }
        }
      }
    },
    "OpenSSH did not return a usable host, username, and port.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSSH did not return a usable host, username, and port."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSSH 未返回可用的主机、用户名和端口。"
          }
        }
      }
    },
    "OpenSSH lists multiple identity files. Choose one credential explicitly; Tamio does not try this list in order.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSSH lists multiple identity files. Choose one credential explicitly; Tamio does not try this list in order."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSSH 列出了多个身份文件。请明确选择一个凭据；Tamio 不会依次尝试此列表。"
          }
        }
      }
    },
    "OpenSSH local and remote commands are not imported.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSSH local and remote commands are not imported."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会导入 OpenSSH 本地和远程命令。"
          }
        }
      }
    },
    "OpenSSH port, X11 and tunnel forwarding settings are not imported.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSSH port, X11 and tunnel forwarding settings are not imported."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会导入 OpenSSH 端口、X11 和隧道转发设置。"
          }
        }
      }
    },
    "OpenSSH produced too much output while resolving this host.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSSH produced too much output while resolving this host."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSSH 解析此主机时产生的输出过多。"
          }
        }
      }
    },
    "OpenSSH returned a configuration that is not UTF-8 text.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSSH returned a configuration that is not UTF-8 text."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSSH 返回的配置不是 UTF-8 文本。"
          }
        }
      }
    },
    "OpenSSH returned an invalid configuration result.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSSH returned an invalid configuration result."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSSH 返回了无效的配置解析结果。"
          }
        }
      }
    },
    "OpenSSH took too long to resolve this host. Any resolution commands were stopped.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSSH took too long to resolve this host. Any resolution commands were stopped."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSSH 解析此主机超时。相关解析命令已停止。"
          }
        }
      }
    },
    "Private-key validation was cancelled or timed out.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private-key validation was cancelled or timed out."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "私钥验证已取消或超时。"
          }
        }
      }
    },
    "Proxy commands that pass file descriptors are not supported.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxy commands that pass file descriptors are not supported."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持传递文件描述符的代理命令。"
          }
        }
      }
    },
    "Resolving the SSH configuration exceeded the 60-second time limit.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolving the SSH configuration exceeded the 60-second time limit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 配置解析超过了 60 秒时限。"
          }
        }
      }
    },
    "Review and acknowledge this host's warnings before importing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review and acknowledge this host's warnings before importing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在导入前检查并确认此主机的警告。"
          }
        }
      }
    },
    "SSH certificates and hardware-backed security keys are not supported by Tamio's connection engine.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH certificates and hardware-backed security keys are not supported by Tamio's connection engine."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamio 连接引擎不支持 SSH 证书和硬件安全密钥。"
          }
        }
      }
    },
    "SSH configuration file %@ is larger than 1 MB.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH configuration file %@ is larger than 1 MB."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 配置文件 %@ 超过 1 MB。"
          }
        }
      }
    },
    "SSH configuration file %@ is not valid UTF-8 text.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH configuration file %@ is not valid UTF-8 text."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 配置文件 %@ 不是有效的 UTF-8 文本。"
          }
        }
      }
    },
    "SSH configuration path %@ is not a regular file.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH configuration path %@ is not a regular file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 配置路径 %@ 不是普通文件。"
          }
        }
      }
    },
    "Saving without credentials requires explicit acknowledgement.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving without credentials requires explicit acknowledgement."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存无凭据的主机需要明确确认。"
          }
        }
      }
    },
    "Scan the SSH configuration again before resolving it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan the SSH configuration again before resolving it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在解析前重新扫描 SSH 配置。"
          }
        }
      }
    },
    "Several saved servers match this host. Resolve the duplicates before importing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Several saved servers match this host. Resolve the duplicates before importing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多台已有服务器与此主机匹配。请在导入前解决重复项。"
          }
        }
      }
    },
    "Tamio does not use the OpenSSH agent, keychain integration or agent forwarding. Choose a stored credential or explicitly import a key.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamio does not use the OpenSSH agent, keychain integration or agent forwarding. Choose a stored credential or explicitly import a key."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamio 不使用 OpenSSH 代理、钥匙串集成或代理转发。请选择已有凭据或明确导入密钥。"
          }
        }
      }
    },
    "Tamio uses its own connection and host-trust policy; these OpenSSH settings are not imported: %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamio uses its own connection and host-trust policy; these OpenSSH settings are not imported: %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamio 使用独立的连接和主机信任策略；不会导入以下 OpenSSH 设置：%@。"
          }
        }
      }
    },
    "The SSH Include patterns inspect too many directory entries.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The SSH Include patterns inspect too many directory entries."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH Include 模式检查的目录项过多。"
          }
        }
      }
    },
    "The SSH configuration contains an Include cycle at %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The SSH configuration contains an Include cycle at %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 配置在 %@ 处存在 Include 循环。"
          }
        }
      }
    },
    "The SSH configuration contains more than 512 server aliases.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The SSH configuration contains more than 512 server aliases."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 配置包含超过 512 个服务器别名。"
          }
        }
      }
    },
    "The SSH configuration exceeds the 4 MB import limit or the 1 MB per-file limit.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The SSH configuration exceeds the 4 MB import limit or the 1 MB per-file limit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 配置超过 4 MB 总导入限制或单文件 1 MB 限制。"
          }
        }
      }
    },
    "The SSH configuration includes too many files or too many nested Includes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The SSH configuration includes too many files or too many nested Includes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 配置包含过多文件或 Include 嵌套层级过深。"
          }
        }
      }
    },
    "The import selection is invalid. Review the configuration again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The import selection is invalid. Review the configuration again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入选择无效。请重新检查配置。"
          }
        }
      }
    },
    "The key file is too large or is not UTF-8 text.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key file is too large or is not UTF-8 text."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥文件过大或不是 UTF-8 文本。"
          }
        }
      }
    },
    "The key must be a regular file smaller than 1 MB.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key must be a regular file smaller than 1 MB."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥必须是小于 1 MB 的普通文件。"
          }
        }
      }
    },
    "The private key could not be opened. Check its format and passphrase.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The private key could not be opened. Check its format and passphrase."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开私钥。请检查格式和口令。"
          }
        }
      }
    },
    "The private key could not be validated.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The private key could not be validated."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证私钥。"
          }
