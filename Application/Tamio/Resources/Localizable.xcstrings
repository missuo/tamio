    "setting.vt-kam-allowed.summary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If true, allows the 'KAM' mode (ANSI mode 2) to lock keyboard input."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，允许终端程序使用 KAM 模式（ANSI 模式 2）锁定键盘输入。"
          }
        }
      }
    },
    "setting.vt-kam-allowed.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VT kam mode allowed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 VT KAM 模式"
          }
        }
      }
    },
    "setting.window-padding-balance.summary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spread leftover space evenly around the grid when window padding is set."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置窗口边距后，将剩余多出的空间均匀分配在终端网格四周。"
          }
        }
      }
    },
    "setting.window-padding-balance.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Balance padding"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平分边缘留白"
          }
        }
      }
    },
    "setting.window-padding-color.summary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The color of the padding area of the window. Can be background or extend."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口边距填充区域的颜色。可使用背景色或延伸边缘单元格颜色。"
          }
        }
      }
    },
