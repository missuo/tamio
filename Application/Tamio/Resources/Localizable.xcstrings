    "The key each server presents on its next connection is saved as its key.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key each server presents on its next connection is saved as its key."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每台服务器在下次连接时提供的密钥将被保存为其主机密钥。"
          }
        }
      }
    },
    "The key the server presents on the next connection is saved as its key. Do this only when you know its keys were replaced.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key the server presents on the next connection is saved as its key. Do this only when you know its keys were replaced."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器在下次连接时提供的密钥将被保存为其主机密钥。请仅在确认服务器密钥已更换时执行此操作。"
          }
        }
      }
    },
    "The saved key is discarded when you save. Servers that trust it will not accept a new key until its public key is added.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved key is discarded when you save. Servers that trust it will not accept a new key until its public key is added."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存后原密钥将被丢弃。信任原密钥的服务器在添加新公钥前将无法使用新密钥登录。"
          }
        }
      }
    },
