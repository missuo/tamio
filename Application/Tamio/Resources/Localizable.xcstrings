            "state": "translated",
            "value": "配色主题"
          }
        }
      }
    },
    "setting.title.summary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this instead of the title the remote host or running command reports."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用该固定标题替代远程主机或运行命令上报的动态标题。"
          }
        }
      }
    },
    "setting.title.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixed session title"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定会话标题"
          }
        }
      }
