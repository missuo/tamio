    "setting.scrollback-limit.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Memory kept for lines that have scrolled off the top. Older lines drop once full."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为滚出屏幕顶部的历史输出保留的最大内存。缓冲区写满后将丢弃最早的历史行。"
          }
