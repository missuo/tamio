    "setting.mouse-scroll-multiplier.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Multiplies trackpad (precise) and mouse wheel (line) scrolling speed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "倍增触控板（平滑）与鼠标滚轮（按行）的滚动速度。"
